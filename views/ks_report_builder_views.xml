<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_ks_report_builder_tree" model="ir.ui.view">
        <field name="name">ks.report.builder.list</field>
        <field name="model">ks.report.builder</field>
        <field name="arch" type="xml">
            <list string="Reports">
                <field name="name"/>
                <field name="model_id"/>
                <field name="model_name"/>
                <field name="state" widget="badge"
                    decoration-success="state == 'deployed'"
                    decoration-muted="state == 'draft'"/>
            </list>
        </field>
    </record>

    <record id="view_ks_report_builder_form" model="ir.ui.view">
        <field name="name">ks.report.builder.form</field>
        <field name="model">ks.report.builder</field>
        <field name="arch" type="xml">
            <form string="Report">
                <header>
                    <button name="action_deploy" string="Deploy" type="object"
                        class="btn-primary" invisible="state == 'deployed'"/>
                    <button name="action_open_report" string="Open Report" type="object"
                        class="btn-primary" invisible="state != 'deployed'"/>
                    <button name="action_undeploy" string="Undeploy" type="object"
                        invisible="state != 'deployed'"
                        confirm="This removes the generated model, views and menu. The definition is kept."/>
                    <button name="action_open_designer" string="Edit in Designer" type="object"
                        title="Reopen these columns on the visual canvas. If this report is deployed, Undeploy it first - saving from the designer replaces the whole column set."/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,deployed"/>
                </header>
                <sheet>
                    <div class="alert alert-warning" role="alert"
                        invisible="not deploy_warning">
                        <field name="deploy_warning" readonly="1" nolabel="1"/>
                    </div>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="e.g. Product-wise Discount"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="model_id" options="{'no_create': True}"/>
                            <field name="base_model_name" invisible="1"/>
                            <field name="domain" widget="domain"
                                options="{'model': 'base_model_name', 'in_dialog': True}"/>
                            <field name="model_name" invisible="1"/>
                            <field name="result_domain" widget="domain"
                                invisible="state != 'deployed'"
                                options="{'model': 'model_name', 'in_dialog': True}"/>
                        </group>
                        <group>
                            <field name="group_ids" widget="many2many_tags"/>
                            <field name="lang_id" options="{'no_create': True}"/>
                            <field name="property_company_id" options="{'no_create': True}"/>
                            <field name="create_menu"/>
                            <field name="menu_parent_id" invisible="not create_menu"
                                options="{'no_create': True}"/>
                            <field name="skip_company_check"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Columns" name="columns">
                            <!-- Deliberately narrow: Type, Definition and
                                 Label. Everything kind-specific lives in the
                                 form dialog below, shown only when it
                                 applies. -->
                            <field name="field_ids" mode="list">
                                <list>
                                    <field name="sequence" widget="handle"/>
                                    <field name="kind"/>
                                    <field name="definition"/>
                                    <field name="label"/>
                                    <field name="ttype" optional="hide"/>
                                    <field name="column_name" optional="hide"/>
                                </list>
                                <form string="Column">
                                    <group>
                                        <field name="base_model_id" invisible="1"/>
                                        <field name="base_model_technical_name" invisible="1"/>
                                        <field name="flat_model_name" invisible="1"/>
                                        <field name="label" placeholder="e.g. Total Sold"/>
                                        <field name="kind"/>
                                        <field name="searchable"/>
                                        <field name="groupable"/>
                                    </group>
                                    <group string="Field" invisible="kind != 'path'">
                                        <field name="path" widget="ks_field_chain_list_picker"
                                            options="{'model': 'base_model_technical_name'}"
                                            nolabel="0"/>
                                        <div colspan="2" class="text-muted"
                                            invisible="not flat_model_name">
                                            This field goes through a list, so one record
                                            matches many rows. Choose how to reduce them:
                                        </div>
                                        <field name="collapse" invisible="not flat_model_name"
                                            required="flat_model_name"/>
                                        <field name="flat_domain" widget="domain"
                                            invisible="not flat_model_name"
                                            options="{'model': 'flat_model_name', 'in_dialog': True}"/>
                                    </group>
                                    <group string="Computed" invisible="kind != 'expression'">
                                        <field name="expression" widget="ks_expression_picker"
                                            nolabel="0"/>
                                    </group>
                                    <group string="Aggregate" invisible="kind != 'aggregate'">
                                        <field name="agg_base_path" widget="ks_field_chain_picker"
                                            options="{'model': 'base_model_technical_name'}"/>
                                        <field name="agg_model_id" options="{'no_create': True}"/>
                                        <field name="agg_model_technical_name" invisible="1"/>
                                        <field name="agg_link_field_id" options="{'no_create': True}"/>
                                        <field name="agg_measure_field_id" options="{'no_create': True}"/>
                                        <field name="agg_function"/>
                                        <field name="agg_domain" widget="domain"
                                            options="{'model': 'agg_model_technical_name', 'in_dialog': True}"/>
                                    </group>
                                </form>
                            </field>
                        </page>
                        <page string="Technical" name="technical" groups="base.group_no_one">
                            <group>
                                <field name="model_name"/>
                                <field name="generated_model_id"/>
                                <field name="action_id"/>
                                <field name="menu_id"/>
                            </group>
                            <field name="query" widget="text"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_ks_report_builder" model="ir.actions.act_window">
        <field name="name">Reports</field>
        <field name="res_model">ks.report.builder</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
